# gh-vault environment variables
# Copy this file to .env and uncomment the variables you want to set.

# Port the web dashboard listens on (default: 8090)
# PORT=8090

# Container path for git clones and bundles (default: /backups)
# BACKUP_DIR=/backups

# Container path for SQLite database and encrypted secrets (default: /config)
# DATA_DIR=/config

# Public URL. Use https:// for secure session cookies (default: http://localhost:8090)
# BASE_URL=http://localhost:8090

# 32-byte base64-encoded AES-256 key for encrypting the GitHub token.
# Auto-generated on first run if not set. Back up the /config dataset to preserve it.
# ENCRYPTION_KEY=
