# gh-vault configuration
# Copy this file to .env and fill in values.

# Required: 32-byte AES key, base64-encoded
# Generate: openssl rand -base64 32
# In Docker Compose this is provided as a secret at /run/secrets/encryption_key
# instead of an environment variable. See docker-compose.yml secrets section.
GHVAULT_ENCRYPTION_KEY=

# Optional (defaults shown)
# GHVAULT_PORT=8090
# GHVAULT_BACKUP_DIR=/backups
# GHVAULT_DATA_DIR=/config
# GHVAULT_BASE_URL=http://localhost:8090
